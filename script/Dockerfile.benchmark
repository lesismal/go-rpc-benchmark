ARG GO_IMAGE=golang:1.27-bookworm
FROM ${GO_IMAGE}

# Where the build downloads from; empty means the upstream default. Set by
# script/docker_benchmark.sh from its DOCKER_BENCH_* variables, which
# script/docker_benchmark_cn.sh points at mirrors reachable from mainland
# China. Build arguments only: the benchmark itself runs with --network none.
#   APT_MIRROR  replaces http://deb.debian.org, e.g. https://mirrors.aliyun.com
#   GO_PROXY    GOPROXY for go mod download, e.g. https://goproxy.cn
ARG APT_MIRROR=
ARG GO_PROXY=

# procps for pgrep/pkill, util-linux for taskset.
RUN if [ -n "$APT_MIRROR" ]; then \
        for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
            if [ -f "$f" ]; then \
                sed -i "s|http://deb.debian.org|$APT_MIRROR|g; s|http://security.debian.org|$APT_MIRROR|g" "$f"; \
            fi; \
        done; \
    fi \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        procps \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY go.mod go.sum ./
RUN if [ -n "$GO_PROXY" ]; then export GOPROXY="$GO_PROXY"; fi \
    && go mod download

COPY . .

# Built here, so that the run's own build (script/benchmark.sh always builds)
# finds everything in the build cache and needs no network.
RUN bash script/build.sh

CMD ["bash", "script/benchmark.sh"]
